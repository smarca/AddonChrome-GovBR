{
  "manifest_version": 3,
  "name": "JusGovBR",
  "short_name": "JusGovBR",
  "version": "261123.38",
  "version_name": "2026.11.23.205136-v38",
  "description": "JusGovBR - Seleção/Cópia Inteligente",
  "author": "smarca@gmail.com",
  "minimum_chrome_version": "116",
  "permissions": [
    "clipboardWrite",
    "scripting",
    "tabs",
    "tabGroups",
    "contextMenus",
    "storage",
    "webNavigation",
    "alarms",
    "idle",
    "offscreen",
    "browsingData",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/cfg/background.js"
  },
  "options_page": "src/cfg/options.html",
  "options_ui": {
    "page": "src/cfg/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "JusGovBR — Seleção/Cópia Inteligente",
    "default_popup": "src/cfg/popup.html"
  },
  "icons": {
    "16": "src/ico/icon16.png",
    "48": "src/ico/icon48.png",
    "128": "src/ico/icon128.png"
  },
  "web_accessible_resources": []
}
